rule "Автоматичне включення світла при русі" 
when 
    Item MotionDetector changed to ON 
then 
    logInfo("Lighting", "Виявлено рух - включення світла") 
    var hour = now.getHour() 
    if (hour >= 6 && hour < 22) { 
        LivingRoomLight.sendCommand(ON) 
        LivingRoomBrightness.sendCommand(80) 
    } else { 
        LivingRoomLight.sendCommand(ON) 
        LivingRoomBrightness.sendCommand(30) 
    } 
    createTimer(now.plusMinutes(5), [| 
        if (MotionDetector.state == OFF) { 
            LivingRoomLight.sendCommand(OFF) 
        } 
    ]) 
end 

rule "Керування всім освітленням" 
when 
    Item AllLights received command 
then 
    val command = receivedCommand 
    LivingRoomLight.sendCommand(command) 
    BedroomLight.sendCommand(command) 
    KitchenLight.sendCommand(command) 
end
